export struct RepoItem {
    name: string,
    path: string,
    repo_type: string, // "local", "s3", "sftp"
}

export global AppState {
    callback navigate(string);
    in-out property <string> current_view: "dashboard";
    in-out property <bool> is_processing: false;
    in-out property <float> progress: 0.0;
}

export global DashboardLogic {
    callback select_repo(RepoItem);
    callback create_new_archive();
    callback refresh_archives();
    in property <[RepoItem]> repositories: [
        { name: "Local Documents", path: "/mnt/backup/docs", repo_type: "local" },
        { name: "S3 Photos", path: "s3://my-bucket/photos", repo_type: "s3" }
    ];
    in property <[[StandardListViewItem]]> archive_data: [
        [ { text: "daily-2023-10-24" }, { text: "2023-10-24 04:00" }, { text: "1.2 GB" } ],
        [ { text: "daily-2023-10-23" }, { text: "2023-10-23 04:00" }, { text: "1.1 GB" } ]
    ];
}
