import { StandardListView } from "std-widgets.slint";
import { ArchiveFilesDialog } from "./archive_files_dialog.slint";

// Shared data structures used across multiple UI components
export struct RepoItem {
    name: string,
    path: string,
    repo_type: string, // "local", "s3", "sftp"
}

export struct ArchiveEntry {
    name: string,
    date: string,
    size: string,
    hostname: string,
    comment: string,
    tags: string,
}

export struct ArchiveContentEntry {
    path: string,
    size: string,
    item_type: string,
}

// Global state for the entire application, like current view
export global AppState {
    callback navigate(string);
    in-out property <string> current_view: "dashboard";
    in-out property <bool> is_processing: false;
    in-out property <float> progress: 0.0;
    
    // Password Dialog State
    in-out property <bool> show_password_dialog: false;
    in-out property <string> password_dialog_message: "Please enter the repository passphrase:";
    // Tracks which action should be retried after authentication ("" | "backup" | "restore")
    in-out property <string> pending_auth_action;
    callback password_dialog_submitted(string);
    callback password_dialog_cancelled();
}

export global ArchiveFilesLogic {
    in-out property <string> current-archive-name;
    callback request-files(string, string, bool);
    in-out property <[string]> file-list;
    in-out property <string> search-term;
    in-out property <bool> use-regex;
    in-out property <bool> show_archive_files_dialog: false;
}

export global DashboardLogic {
    in property <[RepoItem]> repositories;
    in property <int> active_repo_index;
    in property <bool> has_selected_repo;
    in property <[ArchiveEntry]> archives;
    in property <string> terminal_text;
    in property <string> status_text;
    in-out property <length> terminal_height: 200px;
    in-out property <bool> is_scheduled_tasks_active: false;
    in property <bool> is_scheduled_backup_running: false;
    in property <string> scheduled_backup_repo_path;

    // Ready for backup state
    in property <bool> has_pending_archive: false;
    in property <[string]> pending_archive_paths;

    callback new_archive_clicked();
    callback backup_clicked();
    callback refresh_archives();
    callback select_repo(int);
    callback select_scheduled_tasks();
    callback open_restore(ArchiveEntry);
    callback archive_double_clicked(ArchiveEntry);
}

export global NewArchiveWizardLogic {
    in-out property <int> current_step;
    
    // Step 1: Paths
    in-out property <[string]> backup_paths;
    
    // Step 2: Settings
    in-out property <string> compression_level: "zstd,3"; // default
    in-out property <string> redundancy: "none";
    
    // Step 3: Metadata
    in-out property <bool> use_custom_name: false;
    in-out property <string> archive_name;
    in-out property <string> comment;
    in-out property <string> tags; // comma separated

    callback add_path();
    callback remove_path(int);
    callback back();
    callback next();
    callback finish();
    callback cancel();
}

export global InitWizardLogic {
    in-out property <int> current_step;
    in-out property <string> repo_type: "local";
    in-out property <string> repo_name;
    in-out property <string> path_url;
    in-out property <string> access_key;
    in-out property <string> secret_key;
    in-out property <string> password;
    in-out property <string> retype_password;

    callback back();
    callback next();
    callback finish();
    callback cancel();
    callback browse_path();
}

export enum ScheduleType { Daily, Weekly, Monthly, Manual }

export struct BackupSchedule {
    schedule_type: ScheduleType,
    weekday: int,      // 0 = Mon … 6 = Sun
    day_of_month: int, // 1-31 for monthly
    hour: int,
    minute: int,
    run_on_boot_if_missed: bool,
}

export struct ScheduledTask {
    task_name: string,  // Auto-generated: repo_archive_frequency_hh_mm
    repo_name: string,
    archive_name: string,
    schedule: BackupSchedule,
}

export global SchedulerLogic {
    in-out property <[ScheduledTask]> tasks;
    in-out property <int> selected_task_index: -1;

    // For task creation
    in property <[RepoItem]> available_repositories;
    in property <[string]> available_repo_names;  // Helper array of repo names
    in-out property <int> selected_repo_index: -1;

    in property <[ArchiveEntry]> available_archives; // For selected repo
    in property <[string]> available_archive_names;  // Helper array of archive names
    in-out property <int> selected_archive_index: -1;

    // Task being edited/created
    in-out property <int> schedule_type_index: 0; // 0=Daily, 1=Weekly, 2=Monthly, 3=Manual
    in-out property <int> schedule_weekday: 0;
    in-out property <int> schedule_day_of_month: 1;
    in-out property <int> schedule_hour: 3;
    in-out property <int> schedule_minute: 0;
    in-out property <bool> schedule_run_on_boot: true;

    callback new_task();
    callback save_task(ScheduledTask);
    callback delete_task(int);
    callback on_repo_selected(int);  // When user selects a repository
    callback generate_task_name();   // Generate unique task name
}

export global RestoreLogic {
    in-out property <string> selected_archive;
    in-out property <string> restore_path;
    in-out property <bool> dry_run;
    in-out property <bool> use_original_paths; // restore to the same paths used during backup

    callback browse_path();
    callback start_restore();
    callback cancel();
}

export global ArchiveContentLogic {
    in property <string> archive_name;
    in property <[ArchiveContentEntry]> files;
    in-out property <string> search_text;
    in-out property <bool> regex_enabled: false;
    in-out property <bool> show_dialog: false;

    callback search_apply(string, bool);
    callback close();
}
