import { Button, VerticalBox, HorizontalBox, StandardListView, ScrollView } from "std-widgets.slint";
import { DashboardLogic, ArchiveEntry, AppState } from "globals.slint";
import { Theme, CyberButton } from "theme.slint";

component ToolIcon inherits Rectangle {
    in property <image> icon;
    in property <bool> active;
    callback clicked <=> touch.clicked;

    height: 40px;
    width: 40px;
    background: active ? Theme.surface : transparent;

    Rectangle {
        x: 0;
        width: 3px;
        height: parent.height;
        background: root.active ? Theme.primary : transparent;
    }

    touch := TouchArea {}

    Image {
        source: root.icon;
        width: 18px;
        height: 18px;
        colorize: active ? Theme.text : Theme.text-muted;
    }
}

export component DashboardView inherits Rectangle {
    background: Theme.background;

    VerticalLayout {
        // --- Top Menu Bar ---
        Rectangle {
            height: 40px;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: 15px; spacing: 20px;
                Text { text: "File"; color: Theme.text-muted; vertical-alignment: center; }
                Text { text: "Edit"; color: Theme.text-muted; vertical-alignment: center; }
                Text { text: "View"; color: Theme.text-muted; vertical-alignment: center; }
                Text { text: "Repositories"; color: Theme.primary; vertical-alignment: center; font-weight: 700; }
                Rectangle {} // Spacer
                Image { source: @image-url("../assets/search.svg"); width: 16px; height: 16px; colorize: Theme.text-muted; }
                Image { source: @image-url("../assets/settings.svg"); width: 16px; height: 16px; colorize: Theme.text-muted; }
                Rectangle { width: 10px; }
            }
        }

        HorizontalLayout {
            // --- Side Tool Window Bar ---
            Rectangle {
                width: 50px;
                background: Theme.surface;

                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    height: parent.height;
                    background: Theme.border;
                }

                VerticalLayout {
                    padding-top: 10px;
                    ToolIcon { icon: @image-url("../assets/folder.svg"); active: true; }
                    ToolIcon { icon: @image-url("../assets/cloud.svg"); active: false; }
                    ToolIcon { icon: @image-url("../assets/monitor.svg"); active: false; }
                    Rectangle {} // Spacer
                    ToolIcon { icon: @image-url("../assets/save.svg"); active: false; }
                    ToolIcon { icon: @image-url("../assets/clock.svg"); active: false; }
                }
            }

            // --- Main Content Area ---
            VerticalLayout {
                // Breadcrumbs & Actions
                Rectangle {
                    height: 60px;
                    background: Theme.background;
                    HorizontalLayout {
                        padding: 15px; spacing: 10px;
                        Text { text: "local-backups"; color: Theme.text-muted; vertical-alignment: center; }
                        Text { text: ">"; color: Theme.border; vertical-alignment: center; }
                        Text { text: "archives"; color: Theme.text; vertical-alignment: center; }

                        Rectangle {} // Spacer

                        CyberButton {
                            text: "BACKUP NOW";
                            border-color: DashboardLogic.is_scheduled_backup_running || DashboardLogic.has_pending_archive ? #ff9800 : Theme.primary;
                            background: self.pressed ? (DashboardLogic.is_scheduled_backup_running || DashboardLogic.has_pending_archive ? #ef6c00 : Theme.primary) : (self.hovered ? (DashboardLogic.is_scheduled_backup_running || DashboardLogic.has_pending_archive ? #ffb74d : Theme.primary_dim) : transparent);
                            // color is handled inside CyberButton, we might need to tweak it there or just use the defaults
                            clicked => { DashboardLogic.backup_clicked() }
                        }

                        Button {
                            text: "+ NEW ARCHIVE";
                            primary: true;
                            enabled: DashboardLogic.has_selected_repo;
                            clicked => { DashboardLogic.new_archive_clicked() }
                        }

                        Button {
                            text: "+ NEW REPO";
                            clicked => { AppState.navigate("init") }
                        }
                    }
                }

                // Table Headers
                Rectangle {
                    height: 35px;
                    background: Theme.surface;
                    HorizontalLayout {
                        padding-left: 20px;
                        Text { text: "Name"; color: Theme.text-muted; font-size: 13px; vertical-alignment: center; }
                        Text { text: "Date"; width: 150px; color: Theme.text-muted; font-size: 13px; vertical-alignment: center; }
                        Rectangle {}
                    }
                }

                // Table Content
                ScrollView {
                    VerticalLayout {
                        padding: 5px;
                        
                        // Pending Archive Status Box
                        if (DashboardLogic.has_pending_archive || DashboardLogic.is_scheduled_backup_running) : Rectangle {
                            height: 80px;
                            background: Theme.surface;
                            border-width: 2px;
                            border-color: DashboardLogic.is_scheduled_backup_running ? #ff9800 : #137fec; // Orange if scheduled, Blue if pending
                            border-radius: 4px;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 4px;
                                Text {
                                    text: DashboardLogic.is_scheduled_backup_running ? "Scheduled archive backup is running on folder:" : "Archive is now ready to execute for folder:";
                                    color: DashboardLogic.is_scheduled_backup_running ? #ff9800 : #137fec;
                                    font-weight: 700;
                                    font-size: 14px;
                                }
                                ScrollView {
                                    HorizontalLayout {
                                        spacing: 10px;
                                        if (DashboardLogic.is_scheduled_backup_running) : HorizontalLayout {
                                            spacing: 5px;
                                            Image { source: @image-url("../assets/folder.svg"); width: 12px; height: 12px; colorize: Theme.text; }
                                            Text {
                                                text: DashboardLogic.scheduled_backup_repo_path;
                                                color: Theme.text;
                                                font-size: 12px;
                                                font-family: "JetBrains Mono";
                                                overflow: elide;
                                            }
                                        }
                                        if (!DashboardLogic.is_scheduled_backup_running) : Rectangle {
                                            HorizontalLayout {
                                                spacing: 10px;
                                                for path in DashboardLogic.pending_archive_paths : HorizontalLayout {
                                                    spacing: 5px;
                                                    Image { source: @image-url("../assets/folder.svg"); width: 12px; height: 12px; colorize: Theme.text; }
                                                    Text {
                                                        text: path;
                                                        color: Theme.text;
                                                        font-size: 12px;
                                                        font-family: "JetBrains Mono";
                                                        overflow: elide;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        for entry in DashboardLogic.archives: Rectangle {
                            height: 60px;
                            background: touch_row.has-hover ? Theme.surface : transparent;
                            touch_row := TouchArea {
                                double-clicked => { DashboardLogic.archive_double_clicked(entry) }
                            }
                            VerticalLayout {
                                padding-left: 15px;
                                padding-right: 15px;
                                alignment: center;
                                HorizontalLayout {
                                    Text { text: entry.name; color: Theme.text; vertical-alignment: center; font-family: "JetBrains Mono"; font-weight: 700; overflow: elide; }
                                    Text { text: entry.date; width: 150px; color: Theme.text-muted; vertical-alignment: center; }
                                    Rectangle {}
                                    Button {
                                        text: "Show";
                                        clicked => { DashboardLogic.archive_double_clicked(entry) }
                                    }
                                    Rectangle { width: 10px; }
                                    Button {
                                        text: "Restore";
                                        clicked => { DashboardLogic.open_restore(entry) }
                                    }
                                    Rectangle { width: 10px; }
                                }
                                if (entry.hostname != "" || entry.comment != "" || entry.tags != "") : HorizontalLayout {
                                    spacing: 10px;
                                    if (entry.hostname != "") : HorizontalLayout {
                                        spacing: 5px;
                                        Image { source: @image-url("../assets/monitor.svg"); width: 11px; height: 11px; colorize: Theme.text-muted; }
                                        Text { text: entry.hostname; color: Theme.text-muted; font-size: 11px; }
                                    }
                                    if (entry.comment != "") : HorizontalLayout {
                                        spacing: 5px;
                                        Image { source: @image-url("../assets/message-square.svg"); width: 11px; height: 11px; colorize: Theme.text-muted; }
                                        Text { text: entry.comment; color: Theme.text-muted; font-size: 11px; font-italic: true; }
                                    }
                                    if (entry.tags != "") : HorizontalLayout {
                                        spacing: 5px;
                                        Image { source: @image-url("../assets/tag.svg"); width: 11px; height: 11px; colorize: Theme.primary; }
                                        Text { text: entry.tags; color: Theme.primary; font-size: 11px; }
                                    }
                                }
                            }
                        }
                        Rectangle {} // Fill remaining space
                    }
                }

                // --- Bottom Progress & Terminal ---
                Rectangle {
                    height: DashboardLogic.terminal_height;
                    background: Theme.background;

                    // Resize handle
                    Rectangle {
                        y: 0;
                        height: 5px;
                        width: parent.width;
                        background: touch_resize.has-hover ? Theme.primary.with-alpha(0.5) : Theme.border;
                        
                        touch_resize := TouchArea {
                            mouse-cursor: row-resize;
                            moved => {
                                if (self.pressed) {
                                    // Calculate new height. Since the terminal is at the bottom, 
                                    // dragging UP (negative mouse-y relative to top of this rect) 
                                    // should INCREASE the height.
                                    // However, moved mouse-y is relative to the start of the drag on this TouchArea.
                                    // Better to use global mouse pos or just adjust based on delta.
                                    let delta = self.mouse-y - self.pressed-y;
                                    let new_height = DashboardLogic.terminal_height - delta;
                                    // Constrain height
                                    if (new_height > 100px && new_height < 500px) {
                                        DashboardLogic.terminal_height = new_height;
                                    }
                                 }
                            }
                        }
                    }

                    VerticalLayout {
                        padding: 10px;
                        padding-top: 15px; // Extra padding for the resize handle
                        spacing: 10px;
                        
                        // Progress Bar Section
                        if (AppState.is_processing) : VerticalLayout {
                            spacing: 5px;
                            HorizontalLayout {
                                Text { text: "Backup Progress"; color: Theme.text; font-weight: 700; }
                                Rectangle {}
                                Text { text: round(AppState.progress * 100) + "%"; color: Theme.primary; font-family: "JetBrains Mono"; }
                            }
                            Rectangle {
                                height: 8px;
                                background: Theme.surface;
                                border-radius: 4px;
                                Rectangle {
                                    x: 0;
                                    width: parent.width * AppState.progress;
                                    height: parent.height;
                                    background: Theme.primary;
                                    border-radius: 4px;
                                }
                            }
                        }

                        // Terminal Tabs
                        Rectangle {
                            height: 30px;
                            background: Theme.surface;
                            HorizontalLayout {
                                padding-left: 15px; spacing: 20px;
                                Text { text: "TERMINAL"; color: Theme.text; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                                Text { text: "OUTPUT"; color: Theme.text-muted; font-size: 11px; vertical-alignment: center; }
                                Rectangle {}
                                Image { source: @image-url("../assets/x.svg"); width: 12px; height: 12px; colorize: Theme.text-muted; }
                                Rectangle { width: 10px; }
                            }
                        }
                        // Console Text
                        ScrollView {
                            VerticalLayout {
                                padding: 10px;
                                if (DashboardLogic.processed_files.length > 0) : VerticalLayout {
                                    spacing: 2px;
                                    for file in DashboardLogic.processed_files : Text {
                                        text: "✓ " + file;
                                        color: Theme.primary;
                                        font-family: "JetBrains Mono";
                                        font-size: 11px;
                                    }
                                    Rectangle { height: 10px; } // Spacer
                                }
                                Text {
                                    text: DashboardLogic.terminal_text;
                                    color: Theme.text;
                                    font-family: "JetBrains Mono";
                                    font-size: 12px;
                                }
                            }
                        }
                    }
                }
            }
        }

        // --- Status Bar ---
        Rectangle {
            height: 25px;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: 10px; padding-right: 10px; spacing: 15px;
                HorizontalLayout {
                    spacing: 5px;
                    Image { source: @image-url("../assets/circle.svg"); width: 11px; height: 11px; colorize: Theme.primary; }
                    Text { text: DashboardLogic.status_text; color: Theme.primary; font-size: 11px; vertical-alignment: center; }
                }
                Text { text: "Last sync: 2m ago"; color: Theme.text-muted; font-size: 11px; vertical-alignment: center; }
                Rectangle {}
                Text { text: "Borg 1.2.4"; color: Theme.text; font-size: 11px; vertical-alignment: center; font-weight: 700; }
            }
        }
    }
}
