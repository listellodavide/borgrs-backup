import { Button, LineEdit, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { InitWizardLogic } from "globals.slint";
import { Theme } from "theme.slint";

component WizardStepLabel inherits Text {
    in property <bool> active;
    in property <bool> completed;
    color: active ? Theme.primary : (completed ? Theme.primary : Theme.text-muted);
    font-size: 14px;
    font-weight: active ? 700 : 400;
}

component SelectionButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked <=> touch.clicked;

    height: 45px;
    background: selected ? Theme.primary : Theme.surface;
    border-radius: 6px;
    border-width: 1px;
    border-color: selected ? Theme.primary : Theme.border;

    touch := TouchArea {
    }

    Text {
        text: root.text;
        color: selected ? Theme.background : Theme.text;
        font-weight: selected ? 800 : 400;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

export component InitWizardView inherits Rectangle {
    background: Theme.background;
    border-radius: 8px;

    HorizontalLayout {
        // --- Left Stepper ---
        Rectangle {
            width: 200px;
            background: Theme.surface;
            border-top-left-radius: 8px;
            border-bottom-left-radius: 8px;

            VerticalLayout {
                padding: 25px;
                spacing: 25px;
                Text { text: "NEW REPOSITORY"; font-size: 12px; color: Theme.text-muted; font-weight: 800; }
                WizardStepLabel { text: "1. Storage Type"; active: InitWizardLogic.current_step == 0; completed: InitWizardLogic.current_step > 0; }
                WizardStepLabel { text: "2. Details"; active: InitWizardLogic.current_step == 1; completed: InitWizardLogic.current_step > 1; }
                WizardStepLabel { text: "3. Security"; active: InitWizardLogic.current_step == 2; completed: InitWizardLogic.current_step > 2; }
                WizardStepLabel { text: "4. Review"; active: InitWizardLogic.current_step == 3; }
                Rectangle {} // Spacer
            }
        }

        // --- Right Content Area ---
        VerticalLayout {
            padding: 40px;
            spacing: 25px;

            // Step 0: Storage Type
            if (InitWizardLogic.current_step == 0) : VerticalLayout {
                spacing: 20px;
                Text { text: "Select Storage Backend"; font-size: 22px; color: Theme.text; font-weight: 700; }
                HorizontalLayout {
                    spacing: 15px;
                    SelectionButton { 
                        text: "Local Repository"; 
                        selected: InitWizardLogic.repo_type == "local"; 
                        clicked => { InitWizardLogic.repo_type = "local" } 
                    }
                    SelectionButton { 
                        text: "Remote Repository"; 
                        selected: InitWizardLogic.repo_type == "remote"; 
                        clicked => { InitWizardLogic.repo_type = "remote" } 
                    }
                }
            }

            // Step 1: Details
            if (InitWizardLogic.current_step == 1) : VerticalLayout {
                spacing: 20px;
                Text { text: "Repository Details"; font-size: 22px; color: Theme.text; font-weight: 700; }
                
                VerticalLayout {
                    spacing: 8px;
                    Text { text: "Repository Name"; color: Theme.text-muted; font-size: 14px; }
                    LineEdit { 
                        text <=> InitWizardLogic.repo_name; 
                        placeholder-text: "e.g. MyBackups"; 
                    }
                }

                VerticalLayout {
                    spacing: 8px;
                    Text { text: InitWizardLogic.repo_type == "local" ? "Absolute Folder Path" : "Remote URL (ssh://user@host/path)"; color: Theme.text-muted; font-size: 14px; }
                    HorizontalLayout {
                        spacing: 10px;
                        LineEdit { 
                            text <=> InitWizardLogic.path_url; 
                            placeholder-text: InitWizardLogic.repo_type == "local" ? "/home/user/backups" : "ssh://user@host/path"; 
                        }
                        if (InitWizardLogic.repo_type == "local") : Button {
                            text: "Browse...";
                            clicked => { InitWizardLogic.browse_path() }
                        }
                    }
                }

                if (InitWizardLogic.repo_type == "remote") : VerticalLayout {
                    spacing: 15px;
                    Text { text: "Authentication (if needed)"; color: Theme.text-muted; font-size: 14px; }
                    HorizontalLayout {
                        spacing: 15px;
                        VerticalLayout {
                            spacing: 5px;
                            Text { text: "Access Key / User"; color: Theme.text-muted; font-size: 12px; }
                            LineEdit { text <=> InitWizardLogic.access_key; }
                        }
                        VerticalLayout {
                            spacing: 5px;
                            Text { text: "Secret Key / Pass"; color: Theme.text-muted; font-size: 12px; }
                            LineEdit { text <=> InitWizardLogic.secret_key; input-type: password; }
                        }
                    }
                }
            }

            // Step 2: Security
            if (InitWizardLogic.current_step == 2) : VerticalLayout {
                spacing: 20px;
                Text { text: "Encryption Password"; font-size: 22px; color: Theme.text; font-weight: 700; }
                Text { 
                    text: "Enter a strong password to protect your repository encryption key."; 
                    color: Theme.text-muted; 
                    wrap: word-wrap;
                }
                
                VerticalLayout {
                    spacing: 10px;
                    LineEdit { 
                        text <=> InitWizardLogic.password; 
                        input-type: password; 
                        placeholder-text: "Encryption Password"; 
                    }
                    LineEdit { 
                        text <=> InitWizardLogic.retype_password; 
                        input-type: password; 
                        placeholder-text: "Retype Password"; 
                    }
                    if (InitWizardLogic.password != "" && InitWizardLogic.password != InitWizardLogic.retype_password) : Text {
                        text: "Passwords do not match!";
                        color: #ff5555;
                        font-size: 12px;
                    }
                }
            }

            // Step 3: Review
            if (InitWizardLogic.current_step == 3) : VerticalLayout {
                spacing: 20px;
                Text { text: "Final Review"; font-size: 22px; color: Theme.text; font-weight: 700; }
                Rectangle {
                    background: Theme.surface;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.border;
                    VerticalLayout {
                        padding: 15px;
                        spacing: 10px;
                        Text { text: "Name: " + InitWizardLogic.repo_name; color: Theme.text; }
                        Text { text: "Type: " + InitWizardLogic.repo_type; color: Theme.text; }
                        Text { text: "Path: " + InitWizardLogic.path_url; color: Theme.text; }
                        Rectangle { height: 1px; background: Theme.border; }
                        Text {
                            text: "Ready to initialize repository.";
                            color: Theme.primary;
                            font-weight: 700;
                        }
                    }
                }
            }

            Rectangle {} // Vertical Spacer

            // --- Footer Controls ---
            HorizontalLayout {
                spacing: 15px;
                Button { 
                    text: "Cancel"; 
                    clicked => { InitWizardLogic.cancel() } 
                }
                Rectangle {} // Spacer
                if (InitWizardLogic.current_step > 0) : Button {
                    text: "Back";
                    clicked => { InitWizardLogic.back() }
                }
                if (InitWizardLogic.current_step < 3) : Button {
                    text: "Next";
                    primary: true;
                    clicked => { InitWizardLogic.next() }
                }
                if (InitWizardLogic.current_step == 3) : Button {
                    text: "CREATE";
                    primary: true;
                    enabled: InitWizardLogic.password != "" && InitWizardLogic.password == InitWizardLogic.retype_password;
                    clicked => { InitWizardLogic.finish() }
                }
            }
        }
    }
}
