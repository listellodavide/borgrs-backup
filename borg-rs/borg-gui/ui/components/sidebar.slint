import { DashboardLogic } from "../globals.slint";
import { Theme } from "../theme.slint";

component RepoSidebarItem inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked <=> touch.clicked;

    height: 40px;
    background: active ? Theme.surface : transparent;
    border-radius: 4px;

    touch := TouchArea {}

    HorizontalLayout {
        padding-left: 15px;
        spacing: 12px;
        Image {
            source: active ? @image-url("../../assets/chevron-right.svg") : @image-url("../../assets/folder.svg");
            width: 16px;
            height: 16px;
            colorize: active ? Theme.primary : Theme.text-muted;
        }
        Text {
            text: root.text;
            color: active ? Theme.text : Theme.text-muted;
            vertical-alignment: center;
            font-weight: active ? 700 : 400;
            overflow: elide;
        }
    }
}

component SectionHeader inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    callback clicked <=> touch.clicked;

    height: 40px;
    touch := TouchArea {}

    HorizontalLayout {
        padding-left: 15px;
        spacing: 12px;
        Image {
            source: root.icon;
            width: 16px;
            height: 16px;
            colorize: Theme.green;
        }
        Text {
            text: root.text;
            color: Theme.green;
            vertical-alignment: center;
            font-weight: 700;
        }
    }
}

export component Sidebar inherits Rectangle {
    width: 250px;
    background: Theme.surface;

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: parent.height;
        background: Theme.border;
    }

    VerticalLayout {
        padding: 15px;
        spacing: 10px;
        Text {
            text: "Backup and Recovery Manager";
            font-size: 14px;
            color: Theme.text;
            font-weight: 800;
        }
        Rectangle { height: 10px; }

        // Backup Repository Section
        SectionHeader {
            text: "Backup Repository";
            icon: @image-url("../../assets/folder.svg");
            clicked => { DashboardLogic.select_repo(-1) } // Selects the section, clears repo selection
        }
        VerticalLayout {
            padding-left: 20px;
            for repo[i] in DashboardLogic.repositories: RepoSidebarItem {
                text: repo.name;
                active: DashboardLogic.active_repo_index == i && DashboardLogic.has_selected_repo && !DashboardLogic.is_scheduled_tasks_active;
                clicked => { DashboardLogic.select_repo(i) }
            }
        }

        Rectangle { height: 20px; }

        // Scheduled Task Section
        SectionHeader {
            text: "Scheduled Task";
            icon: @image-url("../../assets/calendar-clock.svg");
            clicked => { DashboardLogic.select_scheduled_tasks() }
        }
        // You can list tasks here if needed in the future
        // For now, clicking the header navigates to the scheduler view

        Rectangle {} // Spacer
    }
}
