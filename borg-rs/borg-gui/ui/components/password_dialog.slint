import { Button, LineEdit } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { AppState } from "../globals.slint";

export component PasswordDialog inherits Rectangle {
    background: Theme.base.with-alpha(0.8);
    
    // Consume clicks to prevent interaction with background
    TouchArea {}

    Rectangle {
        width: 400px;
        height: 250px;
        background: Theme.mantle;
        border-color: Theme.primary;
        border-width: 1px;
        border-radius: 8px;
        
        VerticalLayout {
            padding: 30px;
            spacing: 20px;
            
            Text {
                text: "PASSPHRASE REQUIRED";
                color: Theme.primary;
                font-size: 18px;
                font-weight: 700;
                horizontal-alignment: center;
            }
            
            Text {
                text: AppState.password_dialog_message;
                color: Theme.text;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
            
            pwd_input := LineEdit {
                input-type: password;
                placeholder-text: "Enter password...";
                accepted => {
                    AppState.password_dialog_submitted(self.text);
                    self.text = "";
                }
            }
            
            HorizontalLayout {
                spacing: 15px;
                alignment: end;
                
                Button {
                    text: "Cancel";
                    clicked => {
                        AppState.password_dialog_cancelled();
                        pwd_input.text = "";
                    }
                }
                
                Button {
                    text: "Unlock";
                    primary: true;
                    clicked => {
                        AppState.password_dialog_submitted(pwd_input.text);
                        pwd_input.text = "";
                    }
                }
            }
        }
    }
}
