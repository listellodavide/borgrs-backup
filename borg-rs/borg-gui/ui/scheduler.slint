import { Button, CheckBox, LineEdit, ComboBox, ScrollView, VerticalBox, StandardListView } from "std-widgets.slint";
import { Theme, CyberButton } from "./theme.slint";
import { SchedulerLogic, ScheduleType, BackupSchedule, ScheduledTask } from "./globals.slint";

export component SchedulerView inherits Rectangle {
    background: Theme.base;

    VerticalLayout {
        padding: 20px;
        spacing: 20px;

        // Header
        HorizontalLayout {
            Text {
                text: "Scheduled Backup Tasks";
                font-size: 20px;
                font-weight: 700;
                color: Theme.text;
                vertical-alignment: center;
            }
            Rectangle {} // Spacer
            CyberButton {
                text: "+ NEW TASK";
                clicked => { SchedulerLogic.new_task() }
            }
        }

        // Add/Edit Form Overlay
        if (SchedulerLogic.selected_task_index >= 0) : Rectangle {
            background: Theme.mantle;
            border-radius: 8px;
            padding: 20px;
            height: 380px; // Increased height to accommodate new field

            VerticalLayout {
                spacing: 15px;
                Text { text: "Task Configuration"; font-weight: 700; color: Theme.primary; }

                HorizontalLayout {
                    spacing: 20px;
                    VerticalLayout {
                        spacing: 5px;
                        Text { text: "Repository"; color: Theme.subtext; }
                        ComboBox {
                            model: SchedulerLogic.available_repo_names;
                            current-value: SchedulerLogic.selected_task_repo_name;
                            selected(value) => {
                                SchedulerLogic.selected_task_repo_name = value;
                                SchedulerLogic.on_repo_selected(self.current-index);
                                SchedulerLogic.generate_task_name();
                            }
                        }
                    }
                    VerticalLayout {
                        spacing: 5px;
                        Text { text: "Archive (Optional)"; color: Theme.subtext; }
                        ComboBox {
                            model: SchedulerLogic.available_archive_names;
                            current-value: SchedulerLogic.selected_task_archive_name;
                            selected(value) => {
                                SchedulerLogic.selected_task_archive_name = value;
                                SchedulerLogic.generate_task_name();
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 20px;
                    VerticalLayout {
                        spacing: 5px;
                        Text { text: "Frequency"; color: Theme.subtext; }
                        ComboBox {
                            model: ["Daily", "Weekly", "Monthly", "Manual"];
                            current-index: SchedulerLogic.selected_task_schedule_type_index;
                            selected(value) => {
                                if (value == "Daily") { SchedulerLogic.selected_task_schedule_type_index = 0; }
                                else if (value == "Weekly") { SchedulerLogic.selected_task_schedule_type_index = 1; }
                                else if (value == "Monthly") { SchedulerLogic.selected_task_schedule_type_index = 2; }
                                else { SchedulerLogic.selected_task_schedule_type_index = 3; }
                                SchedulerLogic.generate_task_name();
                            }
                        }
                    }
                    VerticalLayout {
                        spacing: 5px;
                        Text { text: "Start Time (24H)"; color: Theme.subtext; }
                        HorizontalLayout {
                            spacing: 5px;
                            LineEdit {
                                placeholder-text: "HH";
                                width: 50px;
                                text: (SchedulerLogic.selected_task_hour < 10 ? "0" : "") + SchedulerLogic.selected_task_hour;
                                edited(val) => {
                                    SchedulerLogic.selected_task_hour = val.to-float();
                                    SchedulerLogic.generate_task_name();
                                }
                            }
                            Text { text: ":"; vertical-alignment: center; color: Theme.text; }
                            LineEdit {
                                placeholder-text: "MM";
                                width: 50px;
                                text: (SchedulerLogic.selected_task_minute < 10 ? "0" : "") + SchedulerLogic.selected_task_minute;
                                edited(val) => {
                                    SchedulerLogic.selected_task_minute = val.to-float();
                                    SchedulerLogic.generate_task_name();
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 20px;
                    VerticalLayout {
                        spacing: 5px;
                        Text { text: "Day of Week / Month"; color: Theme.subtext; }

                        if SchedulerLogic.selected_task_schedule_type_index == 1: ComboBox { // Weekly
                            model: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];
                            current-index: SchedulerLogic.selected_task_weekday;
                            selected(value) => {
                                if (value == "Monday") { SchedulerLogic.selected_task_weekday = 0; }
                                else if (value == "Tuesday") { SchedulerLogic.selected_task_weekday = 1; }
                                else if (value == "Wednesday") { SchedulerLogic.selected_task_weekday = 2; }
                                else if (value == "Thursday") { SchedulerLogic.selected_task_weekday = 3; }
                                else if (value == "Friday") { SchedulerLogic.selected_task_weekday = 4; }
                                else if (value == "Saturday") { SchedulerLogic.selected_task_weekday = 5; }
                                else if (value == "Sunday") { SchedulerLogic.selected_task_weekday = 6; }
                            }
                        }

                        if SchedulerLogic.selected_task_schedule_type_index == 2: LineEdit { // Monthly
                            placeholder-text: "Day (1-31)";
                            text: "" + SchedulerLogic.selected_task_day_of_month;
                            edited(val) => { SchedulerLogic.selected_task_day_of_month = val.to-float(); }
                        }

                        if SchedulerLogic.selected_task_schedule_type_index == 0 || SchedulerLogic.selected_task_schedule_type_index == 3: Rectangle {
                            // Spacer for Daily/Manual
                        }
                    }
                    Rectangle {} // Spacer
                }

                CheckBox {
                    text: "Run on boot if missed";
                    checked: SchedulerLogic.selected_task_run_on_boot;
                    toggled => { SchedulerLogic.selected_task_run_on_boot = !SchedulerLogic.selected_task_run_on_boot; }
                }

                HorizontalLayout {
                    spacing: 10px;
                    Button { text: "Cancel"; clicked => { SchedulerLogic.selected_task_index = -1; } }
                    Rectangle {} // Spacer
                    CyberButton { text: "Save Schedule"; clicked => { SchedulerLogic.save_task(); } }
                }
            }
        }

        // Task List Table
        Rectangle {
            background: Theme.mantle;
            border-radius: 4px;

            VerticalLayout {
                // Table Header
                Rectangle {
                    height: 40px;
                    background: Theme.crust;
                    HorizontalLayout {
                        padding-left: 15px;
                        Text { text: "Active"; width: 60px; color: Theme.subtext; vertical-alignment: center; }
                        Text { text: "Repository"; width: 150px; color: Theme.subtext; vertical-alignment: center; }
                        Text { text: "Archive"; width: 150px; color: Theme.subtext; vertical-alignment: center; }
                        Text { text: "Schedule"; width: 200px; color: Theme.subtext; vertical-alignment: center; }
                        Text { text: "Last Execution"; width: 150px; color: Theme.subtext; vertical-alignment: center; }
                        Rectangle {}
                        Text { text: "Actions"; width: 80px; color: Theme.subtext; vertical-alignment: center; }
                    }
                }

                // Table Rows
                ScrollView {
                    VerticalLayout {
                        for task[i] in SchedulerLogic.tasks: Rectangle {
                            height: 50px;

                            HorizontalLayout {
                                padding-left: 15px;
                                VerticalLayout {
                                    alignment: center;
                                    width: 60px;
                                    CheckBox {
                                        checked: task.active;
                                        toggled => { SchedulerLogic.toggle_task_active(i, self.checked); }
                                    }
                                }
                                Text { text: task.repo_name; width: 150px; color: Theme.text; vertical-alignment: center; }
                                Text { text: task.archive_name; width: 150px; color: Theme.text; vertical-alignment: center; }
                                Text {
                                    text: (task.schedule.schedule_type == ScheduleType.Daily ? "Daily" :
                                          (task.schedule.schedule_type == ScheduleType.Weekly ? "Weekly" :
                                          (task.schedule.schedule_type == ScheduleType.Monthly ? "Monthly" : "Manual")))
                                          + " at " + (task.schedule.hour < 10 ? "0" : "") + task.schedule.hour + ":" + (task.schedule.minute < 10 ? "0" : "") + task.schedule.minute;
                                    width: 200px; color: Theme.text; vertical-alignment: center;
                                }
                                Text { text: task.last_run; width: 150px; color: Theme.subtext; vertical-alignment: center; }
                                Rectangle {}
                                HorizontalLayout {
                                    width: 80px;
                                    spacing: 10px;
                                    alignment: center;

                                    // Edit Button
                                    Rectangle {
                                        width: 24px; height: 24px;
                                        Text { text: "⚙️"; color: Theme.subtext; font-size: 16px; vertical-alignment: center; horizontal-alignment: center; }
                                        TouchArea {
                                            clicked => { SchedulerLogic.on_selected_task_index_changed(i); }
                                            mouse-cursor: pointer;
                                        }
                                    }

                                    // Delete Button
                                    Rectangle {
                                        width: 24px; height: 24px;
                                        Text { text: "🗑️"; color: rgb(229, 115, 115); font-size: 16px; vertical-alignment: center; horizontal-alignment: center; }
                                        TouchArea {
                                            clicked => { SchedulerLogic.delete_task(i); }
                                            mouse-cursor: pointer;
                                        }
                                    }
                                }
                            }

                            // Bottom border separator
                            Rectangle {
                                y: parent.height - 1px;
                                height: 1px;
                                background: Theme.base;
                            }
                        }
                    }
                }
            }
        }
    }
}
