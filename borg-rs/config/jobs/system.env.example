# Borg-Rust Backup Job Environment
# =================================
# This file is used by the borg-backup@.service systemd unit
# Copy to /etc/borg-rust/jobs/<jobname>.env and customize

# Repository location (local path or ssh://user@host/path)
BORG_REPO=/var/lib/borg-rust/backups

# Passphrase (use one of these methods)
# Direct passphrase (not recommended for production)
# BORG_PASSPHRASE=your-secret-passphrase

# Passphrase from command
BORG_PASSCOMMAND="cat /etc/borg-rust/secrets/passphrase"

# Alternative: use systemd credentials
# (configure LoadCredential in service file)

# Paths to back up (space-separated)
BACKUP_PATHS="/etc /home /var/lib"

# Additional borg options
BORG_OPTS="--exclude-caches --exclude '*.tmp'"

# SSH options for remote repositories
# BORG_RSH="ssh -i /root/.ssh/backup_key -o BatchMode=yes"

# Rate limiting for remote repos (bytes/second)
# BORG_REMOTE_RATE_LIMIT=1048576

# Checkpoint interval (seconds)
# BORG_CHECKPOINT_INTERVAL=1800
